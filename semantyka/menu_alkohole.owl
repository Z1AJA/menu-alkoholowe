    <!-- http://www.semanticweb.org//bar_menu_20260/untitled-ontology-2#MocneAlkohole -->

    <owl:Class rdf:about="http://www.semanticweb.org//bar_menu_20260/untitled-ontology-2#MocneAlkohole">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org//bar_menu_20260/untitled-ontology-2#Produkt"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org//bar_menu_20260/untitled-ontology-2#maProcenty"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">38.0</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//bar_menu_20260/untitled-ontology-2#Produkt"/>
    </owl:Class>
    


